@layout AdminLayoutComponent
@page "/admin/album"
@rendermode InteractiveServer

<h3>Wybierz datę</h3>
<div class="input-group mb-3">
    <input type="date" class="form-control" @bind="selectedDate" />
</div>

<h3>Wyszukaj album</h3>
<div class="input-group mb-3">
    <input type="text" class="form-control" placeholder="Wpisz tytuł lub wykonawcę..." @bind="searchQuery"
        @bind:event="oninput" />
    <button class="btn btn-primary" @onclick="SearchAlbums" disabled="@isLoading">
        Szukaj
    </button>
</div>

@if (isLoading)
{
    <p>Wyszukiwanie...</p>
}

@if (albums != null && albums.Any())
{
    <div style="height: 25vh; overflow-y: auto; border: 1px solid #ccc; padding: 10px; border-radius: 6px;">
        <ul class="list-unstyled">
            @foreach (var album in albums)
            {
                <li class="mb-2">
                    <strong>@album.Name</strong> - @album.ReleaseDate - @album.ImageUrl
                    <button class="btn btn-sm btn-success ms-2" @onclick="() => SetTodaysAlbumGame(album)">
                        Ustaw jako dzisiejszy album:
                        @album.Id
                    </button>
                </li>
            }
        </ul>
    </div>
}
else if (!string.IsNullOrWhiteSpace(searchQuery) && !isLoading)
{
    <p>Brak wyników.</p>
}

@if (games != null && games.Any()){
    foreach(var game in games){
        <li class="mb-2">
            @game.Date ---> @game.AlbumName ---> @game.SpotifyAlbumId
        </li>
 
    }
    
}